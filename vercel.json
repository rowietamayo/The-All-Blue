{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/all-blue/dist/public",
  "installCommand": "npx pnpm@9 install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_VERSION": "22"
    }
  }
}
