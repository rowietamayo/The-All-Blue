{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/all-blue/dist/public",
  "installCommand": "npx pnpm@9 install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
