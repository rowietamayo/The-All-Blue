# ─────────────────────────────────────────────────
# Copy this file to .env and fill in the real values
# DO NOT commit .env to version control
# ─────────────────────────────────────────────────

# PostgreSQL connection string (Neon recommended)
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Server port (used in local/container mode; ignored on Vercel serverless)
PORT=5000

# ImageKit.io — used for image uploads
# Get keys from https://imagekit.io → Developer options
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-imagekit-id>
IMAGEKIT_PUBLIC_KEY=public_<your-public-key>
IMAGEKIT_PRIVATE_KEY=private_<your-private-key>

# Admin phone number for admin login
ADMIN_PHONE=+631234567890
